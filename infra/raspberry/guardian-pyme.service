[Unit]
Description=Guardián PyME monitoring node
Requires=docker.service
Wants=tailscale-online.target
After=docker.service tailscale-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/guardian-pyme
ExecStart=/usr/bin/docker compose up -d --force-recreate
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
