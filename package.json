{
  "name": "guardian-pyme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prepare-hosting.mjs",
    "clean": "node scripts/clean.mjs",
    "start": "vinext start",
    "export:static": "node scripts/export-static.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "report": "node scripts/guardian-report.mjs",
    "consolidate": "node scripts/guardian-consolidate.mjs",
    "audit:domain": "node scripts/guardian-domain-audit.mjs",
    "check": "npm run clean && npm test && tsc --noEmit && vinext check && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.2",
    "vinext": "1.0.0-beta.4",
    "vite": "8.1.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
