[Unit]
Description=Guardián PyME external heartbeat
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
EnvironmentFile=/home/pi/guardian-pyme/.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 15 ${GUARDIAN_HEARTBEAT_URL}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6

